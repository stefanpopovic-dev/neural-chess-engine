{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/move.py": {
      "maxDuration": 15,
      "excludeFiles": "{public/**,tests/**,scripts/**,results/**,models/*.pt}"
    }
  },
  "headers": [
    {
      "source": "/pieces/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=604800" }]
    }
  ]
}
